# EA Map assistant (Gemini). Without a key the assistant answers 503 «non configurato».
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional, comma-separated: models tried when the main one stays overloaded (503/429)
GEMINI_FALLBACK_MODELS=
