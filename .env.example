# Backend
DATABASE_URL=postgresql+asyncpg://qachub:changeme@localhost:5432/qachub
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-32-bytes-fernet-key=====

# OIDC / Auth
OIDC_ISSUER=https://your-idp.example.com
OIDC_AUDIENCE=qa-hub-backend

# CORS
CORS_ORIGINS=http://localhost:3000

# Integrations (fill in per-integration)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

GITHUB_TOKEN=
GITHUB_ORG=

# Quality Gate launch: needs Actions "Read and write" on the TAS repository
TAS_GITHUB_TOKEN=
TAS_REPO=pagopa/pagopa-platform-integration-test
TAS_WORKFLOW_FILE=test-automation-service.yml
TAS_REF=main
# Comma-separated launchable suites; empty = any well-formed suite name
QG_LAUNCH_SUITES=

GITLAB_TOKEN=
GITLAB_BASE_URL=

CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=

NOTION_TOKEN=

ALLURE_BASE_URL=
ALLURE_TOKEN=

SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=qa-hub-backend


# Superset
SUPERSET_MAIN_DASHBOARD_ID=1
SUPERSET_BASE_URL=http://localhost:8088
SUPERSET_GUEST_USERNAME=service
SUPERSET_GUEST_FIRST_NAME=service
SUPERSET_GUEST_LAST_NAME=service
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=

# EA Map assistant (Gemini). Without a key the assistant answers 503 «non configurato».
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional, comma-separated: models tried when the main one stays overloaded (503/429)
GEMINI_FALLBACK_MODELS=

# Test Lifecycle — integrazione Git (vuoto: usa TAS_GITHUB_TOKEN)
TL_GITHUB_TOKEN=
TL_REPO=pagopa/pagopa-platform-integration-test
TL_BASE_BRANCH=main
# Solo sviluppo: TL_GIT_MODE=local usa un clone su disco al posto di GitHub
TL_GIT_MODE=github
TL_LOCAL_REPO_PATH=
# Test Lifecycle — Jira (usa JIRA_BASE_URL / JIRA_EMAIL / JIRA_API_TOKEN)
TL_JIRA_PROJECT=PQ
TL_JIRA_DESIGN_ISSUE_TYPE=Progettazione Scenari e casi di test
TL_JIRA_IMPL_ISSUE_TYPE=Implementazione suite di TA
TL_JIRA_EPIC_ISSUE_TYPE=Epic
TL_JIRA_LABEL=testing
TL_JIRA_LINK_TYPE=Relates
TL_JIRA_REFRESH_INTERVAL_S=900
