# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=qa-hub-backend


# Superset
SUPERSET_MAIN_DASHBOARD_ID=1
SUPERSET_BASE_URL=http://localhost:8088
SUPERSET_GUEST_USERNAME=service
SUPERSET_GUEST_FIRST_NAME=service
SUPERSET_GUEST_LAST_NAME=service
SUPERSET_USERNAME=admin
